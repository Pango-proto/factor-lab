{
  "protocol_id": "research_protocol_v1",
  "version": 1,
  "targets": {
    "trading_days_per_year": 252,
    "burn_in_horizon_factor_multiplier": 3,
    "minimum_annual_cycles": 2,
    "ewma_correlation_effective_obs_per_factor": 10,
    "ewma_variance_effective_obs_per_factor": 3,
    "target_two_sided_tail_probability": 0.001,
    "maximum_missingness_variance_inflation": 1.5,
    "minimum_category_members_floor": 5,
    "minimum_category_cross_section_fraction": 0.001,
    "target_relative_numerical_error": 1e-12,
    "huber_target_normal_efficiency": 0.95,
    "maximum_post_burn_invalid_date_ratio": 0.0
  },
  "frozen_choices": {
    "estimation_start": "2019-07-01",
    "backtest_display_start": "2023-07-01",
    "holdout": {
      "start": "2025-03-01",
      "sealed_at": "2026-08-15",
      "sealed": true,
      "opened": false,
      "rationale": "Sealed before alpha registration and factor-result inspection; never derived or moved."
    },
    "stress_test": {
      "start": "2015-01-01",
      "end": "2018-12-31",
      "usage": "out_of_model_only"
    },
    "evaluation_horizon_policy": "alpha_assertion.horizon_days",
    "shrinkage_prior_precision": 1.0,
    "fdr_q": 0.1
  },
  "external_facts": {
    "config_path": "config/external_facts_v1.json"
  }
}
